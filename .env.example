# Copy to .env and fill in. .env is git-ignored.

# Shared secret Notion sends in the X-Learner-Secret header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Your free ngrok static domain (dashboard.ngrok.com -> Domains), e.g. something.ngrok-free.app
NGROK_DOMAIN=

# Optional. Notion internal integration token with access to the Learner 101 page.
# Only used for transport: startup catch-up query, reading a row's Type if the webhook omits it,
# and marking a row failed if the agent crashed. Without it the agent does these via MCP.
NOTION_TOKEN=

# Not 8787: the Cursor MCP OAuth login (agent mcp login) uses localhost:8787 for its callback.
LISTENER_PORT=8788
# Optional: pin the Cursor model (see: agent --list-models). Empty = Cursor default.
AGENT_MODEL=
JOB_TIMEOUT_MIN=45
# Optional override of the Cursor CLI path (defaults to %LOCALAPPDATA%\cursor-agent\cursor-agent.ps1)
AGENT_PATH=
